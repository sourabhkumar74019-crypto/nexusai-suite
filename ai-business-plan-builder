<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Startup Pitch Deck & Business Plan | NexusAI Suite</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cream: { 50: '#FDFBF7', 100: '#FAF7F2', 200: '#F3EDE2', 300: '#E8DEC9', 800: '#3D362A', 900: '#1A1816' },
                        brand: { purple: '#7C3AED', pink: '#DB2777' }
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .card-shadow { box-shadow: 0 4px 14px rgba(0,0,0,0.05); }
        .dark .card-shadow { box-shadow: 0 4px 14px rgba(0,0,0,0.3); }
    </style>
</head>
<body class="bg-cream-100 text-cream-900 dark:bg-[#0B0F19] dark:text-gray-100 min-h-screen flex flex-col justify-between transition-colors duration-300">

    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-cream-100/80 dark:bg-[#0B0F19]/80 border-b border-cream-200 dark:border-gray-800">
        <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-purple-100 dark:bg-purple-900/40 text-brand-purple dark:text-purple-300 border border-purple-200 dark:border-purple-800/50">
                    Tool #08
                </span>
                <h1 class="font-bold text-sm">AI Business Plan Builder</h1>
            </div>

            <div class="flex items-center space-x-3">
                <button id="themeToggle" class="p-2.5 rounded-xl border border-cream-300 dark:border-gray-800 bg-cream-50 dark:bg-gray-900 hover:bg-cream-200 dark:hover:bg-gray-800 transition shadow-sm">
                    <span id="themeIcon">☀️</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Dashboard -->
    <main class="max-w-5xl mx-auto px-4 py-8 flex-1 w-full">
        <div class="text-center max-w-2xl mx-auto mb-8">
            <h2 class="text-3xl font-extrabold tracking-tight mb-2">AI Startup Pitch Deck & Business Plan</h2>
            <p class="text-xs md:text-sm text-cream-800/70 dark:text-gray-400">Generate executive summaries, market strategies, monetization models, and investor pitch deck outlines.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            
            <!-- Left Panel: Inputs -->
            <div class="p-6 rounded-2xl bg-cream-50 dark:bg-[#131927] border border-cream-200 dark:border-gray-800 card-shadow flex flex-col justify-between">
                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Business / Venture Name</label>
                        <input type="text" id="bizName" placeholder="e.g. Nexus Print Studio, Dry Fruit Direct" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Industry / Niche</label>
                            <select id="industry" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                                <option value="E-Commerce & Retail">E-Commerce & Retail</option>
                                <option value="Software / Micro-SaaS">Software / Micro-SaaS</option>
                                <option value="Custom Gift Printing & Design">Custom Printing & Design</option>
                                <option value="Wholesale & Commercial Retail">Wholesale & Distribution</option>
                                <option value="Digital Agency & Services">Digital Agency & Services</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Monetization Model</label>
                            <select id="monetization" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                                <option value="Direct Sales & Retail Margin">Direct Sales Margin</option>
                                <option value="Monthly / Yearly Subscription">Subscription (SaaS)</option>
                                <option value="B2B Wholesale & Bulk Supply">B2B Wholesale</option>
                                <option value="Commission & Affiliate Model">Commission / Affiliate</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Core Product / Problem Solved</label>
                        <textarea id="coreProduct" rows="4" placeholder="e.g. Offering customized premium gift items and bulk dry fruit gift boxes with fast local fulfillment." class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple leading-relaxed"></textarea>
                    </div>
                </div>

                <button onclick="generateBusinessPlan()" id="generateBtn" class="w-full mt-6 py-3 rounded-xl bg-gradient-to-r from-brand-purple to-brand-pink text-white font-bold text-xs hover:opacity-95 transition shadow-lg shadow-purple-500/25 flex items-center justify-center gap-2">
                    <span>🚀 Generate Business Plan</span>
                </button>
            </div>

            <!-- Right Panel: Output -->
            <div class="p-6 rounded-2xl bg-cream-50 dark:bg-[#131927] border border-cream-200 dark:border-gray-800 card-shadow flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4 border-b border-cream-200 dark:border-gray-800 pb-3">
                        <span class="text-xs font-bold text-cream-800/80 dark:text-gray-300 uppercase tracking-wider">Business Plan Blueprint</span>
                        <button onclick="copyToClipboard()" id="copyBtn" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-cream-200 dark:bg-gray-800 hover:bg-brand-purple hover:text-white transition">
                            📋 Copy Plan
                        </button>
                    </div>

                    <div id="outputArea" class="min-h-[260px] p-4 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-200 dark:border-gray-800/80 text-xs leading-relaxed overflow-y-auto whitespace-pre-wrap text-cream-800/90 dark:text-gray-300">
                        Enter your venture details on the left to build a complete business plan and pitch outline.
                    </div>
                </div>

                <div class="mt-4 pt-3 border-t border-cream-200 dark:border-gray-800/60 flex items-center justify-between text-[11px] text-gray-500">
                    <span>Status: <strong id="statusText" class="text-emerald-500">Ready</strong></span>
                    <span>Investor Deck Engine: Active</span>
                </div>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-cream-200 dark:border-gray-800 py-4 text-center text-xs text-cream-800/60 dark:text-gray-500">
        NexusAI Suite App #08 • AI Startup Pitch Deck & Business Plan
    </footer>

    <!-- Logic Script -->
    <script>
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        
        themeToggle.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            themeIcon.textContent = isDark ? '☀️' : '🌙';
            localStorage.setItem('nexus_theme', isDark ? 'dark' : 'light');
        });

        const savedTheme = localStorage.getItem('nexus_theme');
        if (savedTheme === 'light') {
            document.documentElement.classList.remove('dark');
            themeIcon.textContent = '🌙';
        }

        function generateBusinessPlan() {
            const biz = document.getElementById('bizName').value.trim();
            const ind = document.getElementById('industry').value;
            const model = document.getElementById('monetization').value;
            const product = document.getElementById('coreProduct').value.trim();
            const outputArea = document.getElementById('outputArea');
            const statusText = document.getElementById('statusText');

            if (!biz) {
                alert('Please enter a Business Name.');
                return;
            }

            statusText.textContent = "Drafting Business Strategy...";
            outputArea.textContent = "⚙️ Synthesizing executive summary, competitive analysis, and growth channels...";

            setTimeout(() => {
                let prodDesc = product || "High-quality products and tailored services for local and online customers.";
                
                let result = `🚀 BUSINESS PLAN & PITCH DECK: ${biz.toUpperCase()}\n`;
                result += `INDUSTRY: ${ind} | MODEL: ${model}\n`;
                result += `--------------------------------------------------\n\n`;

                result += `📌 1. EXECUTIVE SUMMARY\n`;
                result += `${biz} is a forward-thinking venture in the ${ind} sector. Our core focus is ${prodDesc} By leveraging streamlined operations and targeted digital outreach, ${biz} addresses gaps in local reliability, product quality, and competitive pricing.\n\n`;

                result += `📌 2. MARKET OPPORTUNITY & TARGET AUDIENCE\n`;
                result += `• Target Customers: B2C retail buyers, local corporate clients, and online consumers seeking fast delivery.\n`;
                result += `• Key Problem Solved: Eliminating long fulfillment lead times and overpriced quality offerings.\n`;
                result += `• Value Proposition: High-grade reliability, transparent pricing, and flexible order customization.\n\n`;

                result += `📌 3. REVENUE & MONETIZATION STRATEGY\n`;
                result += `• Core Strategy: ${model}.\n`;
                result += `• Secondary Streams: Custom packaging add-ons, seasonal promotional bundles, and referral partnerships.\n\n`;

                result += `📌 4. MARKETING & GO-TO-MARKET (GTM) CHANNELS\n`;
                result += `• Digital Marketing: Hyper-local social media ads (Instagram/Facebook) and direct WhatsApp business messaging.\n`;
                result += `• B2B Outreach: Direct B2B supplier listing (IndiaMART/Cashify partner network) and corporate gift catalogs.\n`;
                result += `• Retention: Customer loyalty perks, repeat order discounts, and broadcast community updates.\n\n`;

                result += `📌 5. OPERATIONAL MILESTONES\n`;
                result += `• Phase 1: Supplier sourcing, inventory setup, and online storefront/catalog launch.\n`;
                result += `• Phase 2: Initial marketing campaign launch to generate first 100 orders.\n`;
                result += `• Phase 3: Scaling operations and expanding catalog offerings based on customer demand.`;

                outputArea.textContent = result;
                statusText.textContent = "Completed";
            }, 600);
        }

        function copyToClipboard() {
            const text = document.getElementById('outputArea').textContent;
            navigator.clipboard.writeText(text).then(() => {
                const btn = document.getElementById('copyBtn');
                btn.textContent = "✅ Copied!";
                setTimeout(() => btn.textContent = "📋 Copy Plan", 2000);
            });
        }
    </script>
</body>
</html>
