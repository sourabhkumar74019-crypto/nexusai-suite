<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Cold Email & Outreach Studio | NexusAI Suite</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cream: { 50: '#FDFBF7', 100: '#FAF7F2', 200: '#F3EDE2', 300: '#E8DEC9', 800: '#3D362A', 900: '#1A1816' },
                        brand: { purple: '#7C3AED', pink: '#DB2777' }
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .card-shadow { box-shadow: 0 4px 14px rgba(0,0,0,0.05); }
        .dark .card-shadow { box-shadow: 0 4px 14px rgba(0,0,0,0.3); }
    </style>
</head>
<body class="bg-cream-100 text-cream-900 dark:bg-[#0B0F19] dark:text-gray-100 min-h-screen flex flex-col justify-between transition-colors duration-300">

    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-cream-100/80 dark:bg-[#0B0F19]/80 border-b border-cream-200 dark:border-gray-800">
        <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-purple-100 dark:bg-purple-900/40 text-brand-purple dark:text-purple-300 border border-purple-200 dark:border-purple-800/50">
                    Tool #19
                </span>
                <h1 class="font-bold text-sm">AI Cold Email & Outreach Studio</h1>
            </div>

            <div class="flex items-center space-x-3">
                <button id="themeToggle" class="p-2.5 rounded-xl border border-cream-300 dark:border-gray-800 bg-cream-50 dark:bg-gray-900 hover:bg-cream-200 dark:hover:bg-gray-800 transition shadow-sm">
                    <span id="themeIcon">☀️</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Dashboard -->
    <main class="max-w-5xl mx-auto px-4 py-8 flex-1 w-full">
        <div class="text-center max-w-2xl mx-auto mb-8">
            <h2 class="text-3xl font-extrabold tracking-tight mb-2">AI Cold Email & Outreach Studio</h2>
            <p class="text-xs md:text-sm text-cream-800/70 dark:text-gray-400">Generate high-converting B2B cold emails, partnership pitches, and response-driven subject lines.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            
            <!-- Left Panel: Inputs -->
            <div class="p-6 rounded-2xl bg-cream-50 dark:bg-[#131927] border border-cream-200 dark:border-gray-800 card-shadow flex flex-col justify-between">
                <div class="space-y-4">
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Target Recipient</label>
                            <input type="text" id="recipientRole" placeholder="e.g. Founder, Marketing Director, Agency Owner" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                        </div>
                        <div>
                            <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Outreach Goal</label>
                            <select id="outreachGoal" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                                <option value="B2B Software / Service Pitch">B2B Software / Service Pitch</option>
                                <option value="Partnership / Collaboration">Partnership / Collaboration</option>
                                <option value="Freelance / Agency Proposal">Freelance / Agency Proposal</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Tone</label>
                            <select id="emailTone" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                                <option value="Short & Direct">Short & Direct</option>
                                <option value="Professional & Polite">Professional & Polite</option>
                                <option value="Casual & Friendly">Casual & Friendly</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Your Offer / Product</label>
                            <input type="text" id="userOffer" placeholder="e.g. NexusAI 20-in-1 Suite, Custom Printing" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Value Proposition / Key Benefit</label>
                        <textarea id="valueProp" rows="3" placeholder="e.g. Helps automate content creation, saves hours of work, and increases conversion rates." class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple leading-relaxed"></textarea>
                    </div>
                </div>

                <button onclick="generateEmail()" id="generateBtn" class="w-full mt-6 py-3 rounded-xl bg-gradient-to-r from-brand-purple to-brand-pink text-white font-bold text-xs hover:opacity-95 transition shadow-lg shadow-purple-500/25 flex items-center justify-center gap-2">
                    <span>✉️ Generate Cold Email</span>
                </button>
            </div>

            <!-- Right Panel: Output -->
            <div class="p-6 rounded-2xl bg-cream-50 dark:bg-[#131927] border border-cream-200 dark:border-gray-800 card-shadow flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4 border-b border-cream-200 dark:border-gray-800 pb-3">
                        <span class="text-xs font-bold text-cream-800/80 dark:text-gray-300 uppercase tracking-wider">Generated Outreach Pitch</span>
                        <button onclick="copyToClipboard()" id="copyBtn" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-cream-200 dark:bg-gray-800 hover:bg-brand-purple hover:text-white transition">
                            📋 Copy Email
                        </button>
                    </div>

                    <div id="outputArea" class="min-h-[260px] p-4 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-200 dark:border-gray-800/80 text-xs leading-relaxed overflow-y-auto whitespace-pre-wrap text-cream-800/90 dark:text-gray-300">
                        Fill in your outreach parameters on the left and click "Generate Cold Email".
                    </div>
                </div>

                <div class="mt-4 pt-3 border-t border-cream-200 dark:border-gray-800/60 flex items-center justify-between text-[11px] text-gray-500">
                    <span>Status: <strong id="statusText" class="text-emerald-500">Ready</strong></span>
                    <span>Outreach Engine: Active</span>
                </div>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-cream-200 dark:border-gray-800 py-4 text-center text-xs text-cream-800/60 dark:text-gray-500">
        NexusAI Suite App #19 • AI Cold Email & Outreach Studio
    </footer>

    <!-- Logic Script -->
    <script>
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        
        themeToggle.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            themeIcon.textContent = isDark ? '☀️' : '🌙';
            localStorage.setItem('nexus_theme', isDark ? 'dark' : 'light');
        });

        const savedTheme = localStorage.getItem('nexus_theme');
        if (savedTheme === 'light') {
            document.documentElement.classList.remove('dark');
            themeIcon.textContent = '🌙';
        }

        function generateEmail() {
            const role = document.getElementById('recipientRole').value.trim();
            const goal = document.getElementById('outreachGoal').value;
            const tone = document.getElementById('emailTone').value;
            const offer = document.getElementById('userOffer').value.trim();
            const benefit = document.getElementById('valueProp').value.trim();
            const outputArea = document.getElementById('outputArea');
            const statusText = document.getElementById('statusText');

            if (!role || !offer) {
                alert('Please enter both Target Recipient and Your Offer.');
                return;
            }

            statusText.textContent = "Crafting Email...";
            outputArea.textContent = "⚙️ Composing high-converting subject lines, hook, and call to action...";

            setTimeout(() => {
                let benefitText = benefit || "saves time, streamlines workflow, and boosts growth.";
                
                let result = `✉️ COLD EMAIL OUTREACH BLUEPRINT\n`;
                result += `RECIPIENT: ${role} | GOAL: ${goal} | TONE: ${tone}\n`;
                result += `--------------------------------------------------\n\n`;

                result += `📌 SUBJECT LINE OPTIONS:\n`;
                result += `• Quick question regarding your workflow\n`;
                result += `• Scaling ${role} efficiency with ${offer}\n`;
                result += `• Idea for your team / ${offer}\n\n`;

                result += `--------------------------------------------------\n`;
                result += `📧 EMAIL BODY:\n\n`;
                result += `Hi [First Name],\n\n`;
                result += `I hope you're having a great week.\n\n`;
                result += `I've been following your work with ${role} initiatives and noticed you're scaling fast. I wanted to reach out because we built ${offer} specifically to help teams like yours.\n\n`;
                result += `Our platform ${benefitText}, allowing you to eliminate friction and focus entirely on high-impact growth.\n\n`;
                result += `Would you be open to a quick 5-minute overview or a live preview this week?\n\n`;
                result += `Best regards,\n`;
                result += `[Your Name]\n`;
                result += `[Your Contact / WhatsApp]`;

                outputArea.textContent = result;
                statusText.textContent = "Completed";
            }, 600);
        }

        function copyToClipboard() {
            const text = document.getElementById('outputArea').textContent;
            navigator.clipboard.writeText(text).then(() => {
                const btn = document.getElementById('copyBtn');
                btn.textContent = "✅ Copied!";
                setTimeout(() => btn.textContent = "📋 Copy Email", 2000);
            });
        }
    </script>
</body>
</html>
