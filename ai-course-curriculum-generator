<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Course Curriculum Creator | NexusAI Suite</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cream: { 50: '#FDFBF7', 100: '#FAF7F2', 200: '#F3EDE2', 300: '#E8DEC9', 800: '#3D362A', 900: '#1A1816' },
                        brand: { purple: '#7C3AED', pink: '#DB2777' }
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .card-shadow { box-shadow: 0 4px 14px rgba(0,0,0,0.05); }
        .dark .card-shadow { box-shadow: 0 4px 14px rgba(0,0,0,0.3); }
    </style>
</head>
<body class="bg-cream-100 text-cream-900 dark:bg-[#0B0F19] dark:text-gray-100 min-h-screen flex flex-col justify-between transition-colors duration-300">

    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-cream-100/80 dark:bg-[#0B0F19]/80 border-b border-cream-200 dark:border-gray-800">
        <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-purple-100 dark:bg-purple-900/40 text-brand-purple dark:text-purple-300 border border-purple-200 dark:border-purple-800/50">
                    Tool #05
                </span>
                <h1 class="font-bold text-sm">AI Course Curriculum Creator</h1>
            </div>

            <div class="flex items-center space-x-3">
                <button id="themeToggle" class="p-2.5 rounded-xl border border-cream-300 dark:border-gray-800 bg-cream-50 dark:bg-gray-900 hover:bg-cream-200 dark:hover:bg-gray-800 transition shadow-sm">
                    <span id="themeIcon">☀️</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Dashboard -->
    <main class="max-w-5xl mx-auto px-4 py-8 flex-1 w-full">
        <div class="text-center max-w-2xl mx-auto mb-8">
            <h2 class="text-3xl font-extrabold tracking-tight mb-2">AI Course & Syllabus Creator</h2>
            <p class="text-xs md:text-sm text-cream-800/70 dark:text-gray-400">Design structured educational courses, module outlines, learning objectives, and practical assignments.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            
            <!-- Left Panel: Inputs -->
            <div class="p-6 rounded-2xl bg-cream-50 dark:bg-[#131927] border border-cream-200 dark:border-gray-800 card-shadow flex flex-col justify-between">
                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Course Topic / Skill Title</label>
                        <input type="text" id="courseTitle" placeholder="e.g. Master Technical Analysis for Forex & Gold Trading" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Target Audience</label>
                            <select id="targetAudience" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                                <option value="Complete Beginners">Complete Beginners</option>
                                <option value="Intermediate Learners">Intermediate Learners</option>
                                <option value="Advanced Practitioners">Advanced Practitioners</option>
                                <option value="Entrepreneurs & Business Owners">Entrepreneurs</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Course Duration</label>
                            <select id="duration" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                                <option value="4-Week Intensive">4-Week Intensive</option>
                                <option value="8-Week Masterclass">8-Week Masterclass</option>
                                <option value="Weekend Bootcamp">Weekend Bootcamp</option>
                                <option value="Self-Paced Mini Course">Self-Paced Mini Course</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Key Focus Areas / Prerequisites</label>
                        <textarea id="focusAreas" rows="4" placeholder="e.g. Chart Patterns, Risk Management, Entry & Exit Strategies, Live Trade Analysis" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple leading-relaxed"></textarea>
                    </div>
                </div>

                <button onclick="generateSyllabus()" id="generateBtn" class="w-full mt-6 py-3 rounded-xl bg-gradient-to-r from-brand-purple to-brand-pink text-white font-bold text-xs hover:opacity-95 transition shadow-lg shadow-purple-500/25 flex items-center justify-center gap-2">
                    <span>📚 Generate Course Syllabus</span>
                </button>
            </div>

            <!-- Right Panel: Output -->
            <div class="p-6 rounded-2xl bg-cream-50 dark:bg-[#131927] border border-cream-200 dark:border-gray-800 card-shadow flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4 border-b border-cream-200 dark:border-gray-800 pb-3">
                        <span class="text-xs font-bold text-cream-800/80 dark:text-gray-300 uppercase tracking-wider">Curriculum & Module Blueprint</span>
                        <button onclick="copyToClipboard()" id="copyBtn" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-cream-200 dark:bg-gray-800 hover:bg-brand-purple hover:text-white transition">
                            📋 Copy Syllabus
                        </button>
                    </div>

                    <div id="outputArea" class="min-h-[260px] p-4 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-200 dark:border-gray-800/80 text-xs leading-relaxed overflow-y-auto whitespace-pre-wrap text-cream-800/90 dark:text-gray-300">
                        Fill in your course details on the left and click "Generate Course Syllabus".
                    </div>
                </div>

                <div class="mt-4 pt-3 border-t border-cream-200 dark:border-gray-800/60 flex items-center justify-between text-[11px] text-gray-500">
                    <span>Status: <strong id="statusText" class="text-emerald-500">Ready</strong></span>
                    <span>Pedagogy Engine: Active</span>
                </div>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-cream-200 dark:border-gray-800 py-4 text-center text-xs text-cream-800/60 dark:text-gray-500">
        NexusAI Suite App #05 • AI Course Curriculum & Syllabus Creator
    </footer>

    <!-- Logic Script -->
    <script>
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        
        themeToggle.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            themeIcon.textContent = isDark ? '☀️' : '🌙';
            localStorage.setItem('nexus_theme', isDark ? 'dark' : 'light');
        });

        const savedTheme = localStorage.getItem('nexus_theme');
        if (savedTheme === 'light') {
            document.documentElement.classList.remove('dark');
            themeIcon.textContent = '🌙';
        }

        function generateSyllabus() {
            const title = document.getElementById('courseTitle').value.trim();
            const audience = document.getElementById('targetAudience').value;
            const duration = document.getElementById('duration').value;
            const focus = document.getElementById('focusAreas').value.trim();
            const outputArea = document.getElementById('outputArea');
            const statusText = document.getElementById('statusText');

            if (!title) {
                alert('Please enter a Course Title.');
                return;
            }

            statusText.textContent = "Architecting Course...";
            outputArea.textContent = "⚙️ Designing modules, learning outcomes, and practical assignments...";

            setTimeout(() => {
                let focusText = focus || "Core concepts and industry best practices";
                
                let result = `🎓 COURSE TITLE: ${title.toUpperCase()}\n`;
                result += `TARGET AUDIENCE: ${audience} | FORMAT: ${duration}\n`;
                result += `--------------------------------------------------\n\n`;

                result += `📋 COURSE OVERVIEW:\n`;
                result += `This comprehensive curriculum is designed for ${audience} seeking to master ${title}. Through a combination of structured modules and hands-on projects focusing on ${focusText}, students will gain practical, real-world skills.\n\n`;

                result += `📌 MODULE 1: FOUNDATIONS & CORE CONCEPTS\n`;
                result += `• Lesson 1.1: Introduction to ${title}\n`;
                result += `• Lesson 1.2: Essential Tools, Setup, & Terminology\n`;
                result += `• Lesson 1.3: Understanding Fundamentals & Market Structure\n`;
                result += `💡 Assignment: Basic Diagnostic Assessment & Tool Setup\n\n`;

                result += `📌 MODULE 2: STRATEGIC EXECUTION & FRAMEWORKS\n`;
                result += `• Lesson 2.1: Step-by-step Framework for ${focusText.split(',')[0] || 'Core Mechanics'}\n`;
                result += `• Lesson 2.2: Advanced Techniques & Risk Management\n`;
                result += `• Lesson 2.3: Analyzing Real-World Case Studies\n`;
                result += `💡 Assignment: Practical Exercise / Simulation Scenario\n\n`;

                result += `📌 MODULE 3: ADVANCED MASTERY & OPTIMIZATION\n`;
                result += `• Lesson 3.1: High-level Strategies & Common Pitfalls\n`;
                result += `• Lesson 3.2: Scaling Performance & Workflow Automation\n`;
                result += `• Lesson 3.3: Capstone Preparation & Review\n\n`;

                result += `🏆 CAPSTONE PROJECT:\n`;
                result += `Students will build a final end-to-end project applying all concepts learned in ${title}, followed by a peer-review evaluation.`;

                outputArea.textContent = result;
                statusText.textContent = "Completed";
            }, 600);
        }

        function copyToClipboard() {
            const text = document.getElementById('outputArea').textContent;
            navigator.clipboard.writeText(text).then(() => {
                const btn = document.getElementById('copyBtn');
                btn.textContent = "✅ Copied!";
                setTimeout(() => btn.textContent = "📋 Copy Syllabus", 2000);
            });
        }
    </script>
</body>
</html>
