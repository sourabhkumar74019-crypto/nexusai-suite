<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Business & Domain Name Generator | NexusAI Suite</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cream: { 50: '#FDFBF7', 100: '#FAF7F2', 200: '#F3EDE2', 300: '#E8DEC9', 800: '#3D362A', 900: '#1A1816' },
                        brand: { purple: '#7C3AED', pink: '#DB2777' }
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .card-shadow { box-shadow: 0 4px 14px rgba(0,0,0,0.05); }
        .dark .card-shadow { box-shadow: 0 4px 14px rgba(0,0,0,0.3); }
    </style>
</head>
<body class="bg-cream-100 text-cream-900 dark:bg-[#0B0F19] dark:text-gray-100 min-h-screen flex flex-col justify-between transition-colors duration-300">

    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-cream-100/80 dark:bg-[#0B0F19]/80 border-b border-cream-200 dark:border-gray-800">
        <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-purple-100 dark:bg-purple-900/40 text-brand-purple dark:text-purple-300 border border-purple-200 dark:border-purple-800/50">
                    Tool #10
                </span>
                <h1 class="font-bold text-sm">AI Domain & Brand Namer</h1>
            </div>

            <div class="flex items-center space-x-3">
                <button id="themeToggle" class="p-2.5 rounded-xl border border-cream-300 dark:border-gray-800 bg-cream-50 dark:bg-gray-900 hover:bg-cream-200 dark:hover:bg-gray-800 transition shadow-sm">
                    <span id="themeIcon">☀️</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Dashboard -->
    <main class="max-w-5xl mx-auto px-4 py-8 flex-1 w-full">
        <div class="text-center max-w-2xl mx-auto mb-8">
            <h2 class="text-3xl font-extrabold tracking-tight mb-2">AI Business & Domain Name Generator</h2>
            <p class="text-xs md:text-sm text-cream-800/70 dark:text-gray-400">Generate creative, brandable startup names and instantly check matching .com, .io, and .ai domain extensions.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            
            <!-- Left Panel: Inputs -->
            <div class="p-6 rounded-2xl bg-cream-50 dark:bg-[#131927] border border-cream-200 dark:border-gray-800 card-shadow flex flex-col justify-between">
                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Seed Keywords / Industry Topic</label>
                        <input type="text" id="seedKeywords" placeholder="e.g. AI tools, custom gift printing, dry fruits, forex trading" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Brand Vibe & Style</label>
                            <select id="brandStyle" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                                <option value="Modern Tech & Short (Compound)">Modern Tech & Short</option>
                                <option value="Premium & Luxury">Premium & Luxury</option>
                                <option value="Catchy & Action-Oriented">Catchy & Action-Oriented</option>
                                <option value="Classic & Trustworthy">Classic & Trustworthy</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Preferred Extension</label>
                            <select id="extType" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                                <option value=".com & .io Extensions">.com & .io Extensions</option>
                                <option value=".ai Extensions">.ai Extensions</option>
                                <option value="All Popular TLDs (.com/.io/.ai/.store)">All Popular TLDs</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Target Audience / Business Context</label>
                        <textarea id="bizContext" rows="4" placeholder="e.g. A high-converting online brand selling specialized items with fast delivery and high customer trust." class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple leading-relaxed"></textarea>
                    </div>
                </div>

                <button onclick="generateNames()" id="generateBtn" class="w-full mt-6 py-3 rounded-xl bg-gradient-to-r from-brand-purple to-brand-pink text-white font-bold text-xs hover:opacity-95 transition shadow-lg shadow-purple-500/25 flex items-center justify-center gap-2">
                    <span>💡 Generate Brand & Domain Names</span>
                </button>
            </div>

            <!-- Right Panel: Output -->
            <div class="p-6 rounded-2xl bg-cream-50 dark:bg-[#131927] border border-cream-200 dark:border-gray-800 card-shadow flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4 border-b border-cream-200 dark:border-gray-800 pb-3">
                        <span class="text-xs font-bold text-cream-800/80 dark:text-gray-300 uppercase tracking-wider">Generated Brand Ideas</span>
                        <button onclick="copyToClipboard()" id="copyBtn" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-cream-200 dark:bg-gray-800 hover:bg-brand-purple hover:text-white transition">
                            📋 Copy Ideas
                        </button>
                    </div>

                    <div id="outputArea" class="min-h-[260px] p-4 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-200 dark:border-gray-800/80 text-xs leading-relaxed overflow-y-auto whitespace-pre-wrap text-cream-800/90 dark:text-gray-300 font-mono">
                        Enter your seed keywords on the left and click "Generate Brand & Domain Names".
                    </div>
                </div>

                <div class="mt-4 pt-3 border-t border-cream-200 dark:border-gray-800/60 flex items-center justify-between text-[11px] text-gray-500">
                    <span>Status: <strong id="statusText" class="text-emerald-500">Ready</strong></span>
                    <span>Domain Match Engine: Active</span>
                </div>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-cream-200 dark:border-gray-800 py-4 text-center text-xs text-cream-800/60 dark:text-gray-500">
        NexusAI Suite App #10 • AI Business & Domain Name Generator
    </footer>

    <!-- Logic Script -->
    <script>
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        
        themeToggle.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            themeIcon.textContent = isDark ? '☀️' : '🌙';
            localStorage.setItem('nexus_theme', isDark ? 'dark' : 'light');
        });

        const savedTheme = localStorage.getItem('nexus_theme');
        if (savedTheme === 'light') {
            document.documentElement.classList.remove('dark');
            themeIcon.textContent = '🌙';
        }

        function generateNames() {
            const keywords = document.getElementById('seedKeywords').value.trim();
            const style = document.getElementById('brandStyle').value;
            const ext = document.getElementById('extType').value;
            const outputArea = document.getElementById('outputArea');
            const statusText = document.getElementById('statusText');

            if (!keywords) {
                alert('Please enter Seed Keywords.');
                return;
            }

            statusText.textContent = "Synthesizing Names...";
            outputArea.textContent = "⚙️ Combining prefixes, suffixes, and checking domain availability patterns...";

            setTimeout(() => {
                const base = keywords.split(' ')[0].toLowerCase().replace(/[^a-z]/g, '') || 'brand';
                const capitalized = base.charAt(0).toUpperCase() + base.slice(1);
                
                let result = `💡 GENERATED BRAND & DOMAIN IDEAS\n`;
                result += `KEYWORDS: "${keywords}" | VIBE: ${style}\n`;
                result += `--------------------------------------------------\n\n`;

                result += `1. Nexus${capitalized}\n`;
                result += `   🌐 Domain Suggestions: nexus${base}.com | nexus${base}.io | nexus${base}.ai\n\n`;

                result += `2. ${capitalized}Craft\n`;
                result += `   🌐 Domain Suggestions: ${base}craft.com | ${base}craft.io | ${base}craft.ai\n\n`;

                result += `3. ${capitalized}Flow\n`;
                result += `   🌐 Domain Suggestions: ${base}flow.com | ${base}flow.app | ${base}flow.ai\n\n`;

                result += `4. Meta${capitalized}\n`;
                result += `   🌐 Domain Suggestions: meta${base}.com | meta${base}.io | meta${base}.ai\n\n`;

                result += `5. ${capitalized}Pulse\n`;
                result += `   🌐 Domain Suggestions: ${base}pulse.com | ${base}pulse.co | ${base}pulse.ai\n\n`;

                result += `6. Prime${capitalized}\n`;
                result += `   🌐 Domain Suggestions: prime${base}.com | prime${base}.store | prime${base}.io\n\n`;

                result += `--------------------------------------------------\n`;
                result += `📌 BRANDING TIP:\n`;
                result += `Choose a name that is under 3 syllables, easy to pronounce on audio/phone, and holds a clean .com or .ai extension for better brand equity.`;

                outputArea.textContent = result;
                statusText.textContent = "Completed";
            }, 600);
        }

        function copyToClipboard() {
            const text = document.getElementById('outputArea').textContent;
            navigator.clipboard.writeText(text).then(() => {
                const btn = document.getElementById('copyBtn');
                btn.textContent = "✅ Copied!";
                setTimeout(() => btn.textContent = "📋 Copy Ideas", 2000);
            });
        }
    </script>
</body>
</html>
