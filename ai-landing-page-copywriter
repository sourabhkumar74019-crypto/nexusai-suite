<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Landing Page Sales Copywriter | NexusAI Suite</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cream: { 50: '#FDFBF7', 100: '#FAF7F2', 200: '#F3EDE2', 300: '#E8DEC9', 800: '#3D362A', 900: '#1A1816' },
                        brand: { purple: '#7C3AED', pink: '#DB2777' }
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .card-shadow { box-shadow: 0 4px 14px rgba(0,0,0,0.05); }
        .dark .card-shadow { box-shadow: 0 4px 14px rgba(0,0,0,0.3); }
    </style>
</head>
<body class="bg-cream-100 text-cream-900 dark:bg-[#0B0F19] dark:text-gray-100 min-h-screen flex flex-col justify-between transition-colors duration-300">

    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-cream-100/80 dark:bg-[#0B0F19]/80 border-b border-cream-200 dark:border-gray-800">
        <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-purple-100 dark:bg-purple-900/40 text-brand-purple dark:text-purple-300 border border-purple-200 dark:border-purple-800/50">
                    Tool #12
                </span>
                <h1 class="font-bold text-sm">AI Landing Page Copywriter</h1>
            </div>

            <div class="flex items-center space-x-3">
                <button id="themeToggle" class="p-2.5 rounded-xl border border-cream-300 dark:border-gray-800 bg-cream-50 dark:bg-gray-900 hover:bg-cream-200 dark:hover:bg-gray-800 transition shadow-sm">
                    <span id="themeIcon">☀️</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Dashboard -->
    <main class="max-w-5xl mx-auto px-4 py-8 flex-1 w-full">
        <div class="text-center max-w-2xl mx-auto mb-8">
            <h2 class="text-3xl font-extrabold tracking-tight mb-2">AI Landing Page Sales Copywriter</h2>
            <p class="text-xs md:text-sm text-cream-800/70 dark:text-gray-400">Generate high-converting sales page headlines, sub-hooks, feature bullets, and call-to-action sections.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            
            <!-- Left Panel: Inputs -->
            <div class="p-6 rounded-2xl bg-cream-50 dark:bg-[#131927] border border-cream-200 dark:border-gray-800 card-shadow flex flex-col justify-between">
                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Product / Service Name</label>
                        <input type="text" id="productName" placeholder="e.g. NexusAI Suite, FastGift Print Studio" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Target Audience</label>
                            <select id="targetAudience" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                                <option value="SaaS Founders & Agencies">SaaS Founders & Agencies</option>
                                <option value="E-commerce Shoppers">E-commerce Shoppers</option>
                                <option value="Freelancers & Creators">Freelancers & Creators</option>
                                <option value="Local Businesses & B2B">Local Businesses & B2B</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Tone & Formula</label>
                            <select id="copyFormula" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                                <option value="AIDA (Attention, Interest, Desire, Action)">AIDA Formula</option>
                                <option value="PAS (Problem, Agitate, Solution)">PAS Formula</option>
                                <option value="High Energy & Urgency">High Energy & Urgency</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Key Features / Main Benefits</label>
                        <textarea id="keyBenefits" rows="4" placeholder="e.g. 20 ready-to-use AI micro-tools, responsive design, dark mode, zero setup required, full commercial license." class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple leading-relaxed"></textarea>
                    </div>
                </div>

                <button onclick="generateLandingCopy()" id="generateBtn" class="w-full mt-6 py-3 rounded-xl bg-gradient-to-r from-brand-purple to-brand-pink text-white font-bold text-xs hover:opacity-95 transition shadow-lg shadow-purple-500/25 flex items-center justify-center gap-2">
                    <span>🚀 Write Landing Page Copy</span>
                </button>
            </div>

            <!-- Right Panel: Output -->
            <div class="p-6 rounded-2xl bg-cream-50 dark:bg-[#131927] border border-cream-200 dark:border-gray-800 card-shadow flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4 border-b border-cream-200 dark:border-gray-800 pb-3">
                        <span class="text-xs font-bold text-cream-800/80 dark:text-gray-300 uppercase tracking-wider">Landing Page Copy Blueprint</span>
                        <button onclick="copyToClipboard()" id="copyBtn" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-cream-200 dark:bg-gray-800 hover:bg-brand-purple hover:text-white transition">
                            📋 Copy Text
                        </button>
                    </div>

                    <div id="outputArea" class="min-h-[260px] p-4 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-200 dark:border-gray-800/80 text-xs leading-relaxed overflow-y-auto whitespace-pre-wrap text-cream-800/90 dark:text-gray-300">
                        Fill in your product details on the left and click "Write Landing Page Copy".
                    </div>
                </div>

                <div class="mt-4 pt-3 border-t border-cream-200 dark:border-gray-800/60 flex items-center justify-between text-[11px] text-gray-500">
                    <span>Status: <strong id="statusText" class="text-emerald-500">Ready</strong></span>
                    <span>Conversion Formula: Applied</span>
                </div>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-cream-200 dark:border-gray-800 py-4 text-center text-xs text-cream-800/60 dark:text-gray-500">
        NexusAI Suite App #12 • AI Landing Page Sales Copywriter
    </footer>

    <!-- Logic Script -->
    <script>
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        
        themeToggle.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            themeIcon.textContent = isDark ? '☀️' : '🌙';
            localStorage.setItem('nexus_theme', isDark ? 'dark' : 'light');
        });

        const savedTheme = localStorage.getItem('nexus_theme');
        if (savedTheme === 'light') {
            document.documentElement.classList.remove('dark');
            themeIcon.textContent = '🌙';
        }

        function generateLandingCopy() {
            const prod = document.getElementById('productName').value.trim();
            const aud = document.getElementById('targetAudience').value;
            const formula = document.getElementById('copyFormula').value;
            const benefits = document.getElementById('keyBenefits').value.trim();
            const outputArea = document.getElementById('outputArea');
            const statusText = document.getElementById('statusText');

            if (!prod) {
                alert('Please enter a Product or Service Name.');
                return;
            }

            statusText.textContent = "Crafting Sales Copy...";
            outputArea.textContent = "⚙️ Writing hero headlines, benefit hooks, social proof, and CTAs...";

            setTimeout(() => {
                let benefitText = benefits || "Fast execution, premium quality, and instant results.";
                
                let result = `🎯 LANDING PAGE SALES COPY: ${prod.toUpperCase()}\n`;
                result += `TARGET AUDIENCE: ${aud} | FORMULA: ${formula}\n`;
                result += `--------------------------------------------------\n\n`;

                result += `⚡ HERO SECTION (ABOVE THE FOLD)\n`;
                result += `• Main Headline: "Transform the Way You Build & Scale with ${prod}"\n`;
                result += `• Sub-Headline: "The ultimate solution designed for ${aud}. Stop wasting hours and start delivering results with ${benefitText.split(',')[0] || 'proven tools'}."\n`;
                result += `• Primary CTA Button: "Get Instant Access Now ➔"\n`;
                result += `• Secondary CTA Button: "Explore Live Demo"\n\n`;

                result += `--------------------------------------------------\n`;
                result += `🔥 PROBLEM & SOLUTION SECTION\n`;
                result += `• The Problem: "Tired of spending endless hours on tedious tasks and missing out on rapid growth?"\n`;
                result += `• The Solution: "Meet ${prod}. Everything you need packaged into one seamless, easy-to-use platform."\n\n`;

                result += `--------------------------------------------------\n`;
                result += `⭐ KEY FEATURES & BENEFITS\n`;
                result += `• Feature 1: "Turnkey Execution" — ${benefitText}\n`;
                result += `• Feature 2: "Built for ${aud}" — Tailored directly to meet your workflow requirements.\n`;
                result += `• Feature 3: "Maximum Performance" — Lightweight, reliable, and optimized for high conversion.\n\n`;

                result += `--------------------------------------------------\n`;
                result += `💬 SOCIAL PROOF & TESTIMONIAL PLACEHOLDER\n`;
                result += `"Using ${prod} saved our team over 15 hours a week. It’s an essential asset for anyone looking to scale efficiently." — Verified User\n\n`;

                result += `--------------------------------------------------\n`;
                result += `🚀 FINAL CALL TO ACTION (FOOTER CTA)\n`;
                result += `• Headline: "Ready to Supercharge Your Results?"\n`;
                result += `• Body: "Join hundreds of happy users today. Backed by our 100% satisfaction commitment."\n`;
                result += `• Button Text: "Claim Your Suite License Today!"`;

                outputArea.textContent = result;
                statusText.textContent = "Completed";
            }, 600);
        }

        function copyToClipboard() {
            const text = document.getElementById('outputArea').textContent;
            navigator.clipboard.writeText(text).then(() => {
                const btn = document.getElementById('copyBtn');
                btn.textContent = "✅ Copied!";
                setTimeout(() => btn.textContent = "📋 Copy Text", 2000);
            });
        }
    </script>
</body>
</html>
