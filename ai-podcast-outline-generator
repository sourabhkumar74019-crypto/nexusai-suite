<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Podcast Episode & Outline Creator | NexusAI Suite</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cream: { 50: '#FDFBF7', 100: '#FAF7F2', 200: '#F3EDE2', 300: '#E8DEC9', 800: '#3D362A', 900: '#1A1816' },
                        brand: { purple: '#7C3AED', pink: '#DB2777' }
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .card-shadow { box-shadow: 0 4px 14px rgba(0,0,0,0.05); }
        .dark .card-shadow { box-shadow: 0 4px 14px rgba(0,0,0,0.3); }
    </style>
</head>
<body class="bg-cream-100 text-cream-900 dark:bg-[#0B0F19] dark:text-gray-100 min-h-screen flex flex-col justify-between transition-colors duration-300">

    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-cream-100/80 dark:bg-[#0B0F19]/80 border-b border-cream-200 dark:border-gray-800">
        <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-purple-100 dark:bg-purple-900/40 text-brand-purple dark:text-purple-300 border border-purple-200 dark:border-purple-800/50">
                    Tool #11
                </span>
                <h1 class="font-bold text-sm">AI Podcast Outline Creator</h1>
            </div>

            <div class="flex items-center space-x-3">
                <button id="themeToggle" class="p-2.5 rounded-xl border border-cream-300 dark:border-gray-800 bg-cream-50 dark:bg-gray-900 hover:bg-cream-200 dark:hover:bg-gray-800 transition shadow-sm">
                    <span id="themeIcon">☀️</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Dashboard -->
    <main class="max-w-5xl mx-auto px-4 py-8 flex-1 w-full">
        <div class="text-center max-w-2xl mx-auto mb-8">
            <h2 class="text-3xl font-extrabold tracking-tight mb-2">AI Podcast Episode & Outline Creator</h2>
            <p class="text-xs md:text-sm text-cream-800/70 dark:text-gray-400">Structure episode talking points, guest Q&A guides, discussion timestamps, and show notes.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            
            <!-- Left Panel: Inputs -->
            <div class="p-6 rounded-2xl bg-cream-50 dark:bg-[#131927] border border-cream-200 dark:border-gray-800 card-shadow flex flex-col justify-between">
                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Podcast Topic / Episode Title</label>
                        <input type="text" id="episodeTitle" placeholder="e.g. Building Side Income with Digital Micro-SaaS Projects" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Episode Format</label>
                            <select id="podcastFormat" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                                <option value="Solo Host Commentary">Solo Host Commentary</option>
                                <option value="Guest Interview Q&A">Guest Interview Q&A</option>
                                <option value="Co-Host Discussion">Co-Host Discussion</option>
                                <option value="Educational / Deep-Dive">Educational Deep-Dive</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Target Duration</label>
                            <select id="podcastDuration" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                                <option value="15-Minute Micro Episode">15-Minute Micro</option>
                                <option value="30-Minute Standard Episode">30-Minute Standard</option>
                                <option value="45+ Minute Deep Episode">45+ Minute Deep Dive</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Key Points / Guest Background</label>
                        <textarea id="guestInfo" rows="4" placeholder="e.g. Discussing time management, choosing the right tech stack, and launching side hustles while working full-time." class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple leading-relaxed"></textarea>
                    </div>
                </div>

                <button onclick="generatePodcastOutline()" id="generateBtn" class="w-full mt-6 py-3 rounded-xl bg-gradient-to-r from-brand-purple to-brand-pink text-white font-bold text-xs hover:opacity-95 transition shadow-lg shadow-purple-500/25 flex items-center justify-center gap-2">
                    <span>🎙️ Generate Podcast Blueprint</span>
                </button>
            </div>

            <!-- Right Panel: Output -->
            <div class="p-6 rounded-2xl bg-cream-50 dark:bg-[#131927] border border-cream-200 dark:border-gray-800 card-shadow flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4 border-b border-cream-200 dark:border-gray-800 pb-3">
                        <span class="text-xs font-bold text-cream-800/80 dark:text-gray-300 uppercase tracking-wider">Episode Outline & Script</span>
                        <button onclick="copyToClipboard()" id="copyBtn" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-cream-200 dark:bg-gray-800 hover:bg-brand-purple hover:text-white transition">
                            📋 Copy Outline
                        </button>
                    </div>

                    <div id="outputArea" class="min-h-[260px] p-4 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-200 dark:border-gray-800/80 text-xs leading-relaxed overflow-y-auto whitespace-pre-wrap text-cream-800/90 dark:text-gray-300">
                        Fill in your episode details on the left and click "Generate Podcast Blueprint".
                    </div>
                </div>

                <div class="mt-4 pt-3 border-t border-cream-200 dark:border-gray-800/60 flex items-center justify-between text-[11px] text-gray-500">
                    <span>Status: <strong id="statusText" class="text-emerald-500">Ready</strong></span>
                    <span>Show Notes Generator: Active</span>
                </div>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-cream-200 dark:border-gray-800 py-4 text-center text-xs text-cream-800/60 dark:text-gray-500">
        NexusAI Suite App #11 • AI Podcast Episode & Outline Creator
    </footer>

    <!-- Logic Script -->
    <script>
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        
        themeToggle.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            themeIcon.textContent = isDark ? '☀️' : '🌙';
            localStorage.setItem('nexus_theme', isDark ? 'dark' : 'light');
        });

        const savedTheme = localStorage.getItem('nexus_theme');
        if (savedTheme === 'light') {
            document.documentElement.classList.remove('dark');
            themeIcon.textContent = '🌙';
        }

        function generatePodcastOutline() {
            const title = document.getElementById('episodeTitle').value.trim();
            const format = document.getElementById('podcastFormat').value;
            const duration = document.getElementById('podcastDuration').value;
            const details = document.getElementById('guestInfo').value.trim();
            const outputArea = document.getElementById('outputArea');
            const statusText = document.getElementById('statusText');

            if (!title) {
                alert('Please enter a Podcast Topic / Episode Title.');
                return;
            }

            statusText.textContent = "Formatting Outline...";
            outputArea.textContent = "⚙️ Structuring episode intro, key questions, timestamps, and show notes...";

            setTimeout(() => {
                let infoText = details || "Key strategies and practical advice";
                
                let result = `🎙️ PODCAST EPISODE BLUEPRINT: ${title.toUpperCase()}\n`;
                result += `FORMAT: ${format} | DURATION: ${duration}\n`;
                result += `--------------------------------------------------\n\n`;

                result += `⏱️ TIMED EPISODE STRUCTURE:\n\n`;
                result += `[00:00 - 02:00] INTRO & HOOK\n`;
                result += `• Teaser hook highlighting the main topic: "${title}".\n`;
                result += `• Brief intro of host/guest and what listeners will gain.\n\n`;

                result += `[02:00 - 10:00] SEGMENT 1: THE CORE CHALLENGE\n`;
                result += `• Background & context on why ${infoText.split(',')[0] || 'this topic'} matters right now.\n`;
                result += `• Key mistakes to avoid in the beginning.\n\n`;

                result += `[10:00 - 20:00] SEGMENT 2: STRATEGIC INSIGHTS & ACTIONABLE STEPS\n`;
                result += `• Deep-dive into ${infoText}.\n`;
                result += `• Real-world examples and step-by-step framework.\n\n`;

                result += `[20:00 - 28:00] SEGMENT 3: KEY TAKEAWAYS & Q&A\n`;
                result += `• Top 3 actionable takeaways for listeners to implement today.\n`;
                result += `• Rapid-fire Q&A or audience question summary.\n\n`;

                result += `[28:00 - 30:00] OUTRO & CALL TO ACTION\n`;
                result += `• Thank listeners/guest for tuning in.\n`;
                result += `• CTA: Subscribe, leave a review, and visit show links.\n\n`;

                result += `--------------------------------------------------\n`;
                result += `📝 SHOW NOTES & SUMMARY:\n`;
                result += `In this episode of our podcast, we dive into ${title}. Discover how to apply ${infoText} to achieve consistent growth and overcome common obstacles. Don't forget to like and subscribe for weekly episodes!`;

                outputArea.textContent = result;
                statusText.textContent = "Completed";
            }, 600);
        }

        function copyToClipboard() {
            const text = document.getElementById('outputArea').textContent;
            navigator.clipboard.writeText(text).then(() => {
                const btn = document.getElementById('copyBtn');
                btn.textContent = "✅ Copied!";
                setTimeout(() => btn.textContent = "📋 Copy Outline", 2000);
            });
        }
    </script>
</body>
</html>
