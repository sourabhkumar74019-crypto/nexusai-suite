<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI FAQ & Knowledge Base Generator | NexusAI Suite</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cream: { 50: '#FDFBF7', 100: '#FAF7F2', 200: '#F3EDE2', 300: '#E8DEC9', 800: '#3D362A', 900: '#1A1816' },
                        brand: { purple: '#7C3AED', pink: '#DB2777' }
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .card-shadow { box-shadow: 0 4px 14px rgba(0,0,0,0.05); }
        .dark .card-shadow { box-shadow: 0 4px 14px rgba(0,0,0,0.3); }
    </style>
</head>
<body class="bg-cream-100 text-cream-900 dark:bg-[#0B0F19] dark:text-gray-100 min-h-screen flex flex-col justify-between transition-colors duration-300">

    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-cream-100/80 dark:bg-[#0B0F19]/80 border-b border-cream-200 dark:border-gray-800">
        <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-purple-100 dark:bg-purple-900/40 text-brand-purple dark:text-purple-300 border border-purple-200 dark:border-purple-800/50">
                    Tool #15
                </span>
                <h1 class="font-bold text-sm">AI FAQ & Knowledge Base Generator</h1>
            </div>

            <div class="flex items-center space-x-3">
                <button id="themeToggle" class="p-2.5 rounded-xl border border-cream-300 dark:border-gray-800 bg-cream-50 dark:bg-gray-900 hover:bg-cream-200 dark:hover:bg-gray-800 transition shadow-sm">
                    <span id="themeIcon">☀️</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Dashboard -->
    <main class="max-w-5xl mx-auto px-4 py-8 flex-1 w-full">
        <div class="text-center max-w-2xl mx-auto mb-8">
            <h2 class="text-3xl font-extrabold tracking-tight mb-2">AI FAQ & Knowledge Base Generator</h2>
            <p class="text-xs md:text-sm text-cream-800/70 dark:text-gray-400">Generate comprehensive FAQ sections, customer support documentation, and SEO Schema markup.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            
            <!-- Left Panel: Inputs -->
            <div class="p-6 rounded-2xl bg-cream-50 dark:bg-[#131927] border border-cream-200 dark:border-gray-800 card-shadow flex flex-col justify-between">
                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Product / Service / Topic</label>
                        <input type="text" id="faqProduct" placeholder="e.g. NexusAI Suite, E-Commerce Custom Printing" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Output Format</label>
                            <select id="faqFormat" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                                <option value="Standard Text & Q/A">Standard Text & Q/A</option>
                                <option value="JSON-LD SEO Schema">JSON-LD SEO Schema</option>
                                <option value="HTML Accordion Snippet">HTML Accordion Snippet</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Tone of Voice</label>
                            <select id="faqTone" class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple">
                                <option value="Helpful & Professional">Helpful & Professional</option>
                                <option value="Direct & Concise">Direct & Concise</option>
                                <option value="Technical & Detailed">Technical & Detailed</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider text-cream-800/80 dark:text-gray-300">Key Offerings / Policies to Include</label>
                        <textarea id="faqDetails" rows="4" placeholder="e.g. Lifetime access, 20-in-1 tool kit, instant download, customer support, commercial resale rights." class="w-full px-3.5 py-2.5 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-300 dark:border-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-purple leading-relaxed"></textarea>
                    </div>
                </div>

                <button onclick="generateFAQ()" id="generateBtn" class="w-full mt-6 py-3 rounded-xl bg-gradient-to-r from-brand-purple to-brand-pink text-white font-bold text-xs hover:opacity-95 transition shadow-lg shadow-purple-500/25 flex items-center justify-center gap-2">
                    <span>❓ Generate FAQ Section</span>
                </button>
            </div>

            <!-- Right Panel: Output -->
            <div class="p-6 rounded-2xl bg-cream-50 dark:bg-[#131927] border border-cream-200 dark:border-gray-800 card-shadow flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4 border-b border-cream-200 dark:border-gray-800 pb-3">
                        <span class="text-xs font-bold text-cream-800/80 dark:text-gray-300 uppercase tracking-wider">Generated FAQ Knowledgebase</span>
                        <button onclick="copyToClipboard()" id="copyBtn" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-cream-200 dark:bg-gray-800 hover:bg-brand-purple hover:text-white transition">
                            📋 Copy Output
                        </button>
                    </div>

                    <div id="outputArea" class="min-h-[260px] p-4 rounded-xl bg-cream-100 dark:bg-gray-900 border border-cream-200 dark:border-gray-800/80 text-xs leading-relaxed overflow-y-auto whitespace-pre-wrap text-cream-800/90 dark:text-gray-300">
                        Fill in your product details on the left and click "Generate FAQ Section".
                    </div>
                </div>

                <div class="mt-4 pt-3 border-t border-cream-200 dark:border-gray-800/60 flex items-center justify-between text-[11px] text-gray-500">
                    <span>Status: <strong id="statusText" class="text-emerald-500">Ready</strong></span>
                    <span>SEO Schema Engine: Active</span>
                </div>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-cream-200 dark:border-gray-800 py-4 text-center text-xs text-cream-800/60 dark:text-gray-500">
        NexusAI Suite App #15 • AI FAQ & Knowledge Base Generator
    </footer>

    <!-- Logic Script -->
    <script>
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        
        themeToggle.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            themeIcon.textContent = isDark ? '☀️' : '🌙';
            localStorage.setItem('nexus_theme', isDark ? 'dark' : 'light');
        });

        const savedTheme = localStorage.getItem('nexus_theme');
        if (savedTheme === 'light') {
            document.documentElement.classList.remove('dark');
            themeIcon.textContent = '🌙';
        }

        function generateFAQ() {
            const product = document.getElementById('faqProduct').value.trim();
            const format = document.getElementById('faqFormat').value;
            const tone = document.getElementById('faqTone').value;
            const details = document.getElementById('faqDetails').value.trim();
            const outputArea = document.getElementById('outputArea');
            const statusText = document.getElementById('statusText');

            if (!product) {
                alert('Please enter a Product, Service, or Topic.');
                return;
            }

            statusText.textContent = "Compiling FAQ...";
            outputArea.textContent = "⚙️ Synthesizing user queries, answers, and structural code...";

            setTimeout(() => {
                let keyDetails = details || "Instant access, clean user interface, and full support.";

                if (format === "JSON-LD SEO Schema") {
                    let schema = {\n  "@context": "https://schema.org",\n  "@type": "FAQPage",\n  "mainEntity": [\n    {\n      "@type": "Question",\n      "name": "What is ${product}?",\n      "acceptedAnswer": {\n        "@type": "Answer",\n        "text": "${product} is a comprehensive solution offering${keyDetails}."\n      }\n    },\n    {\n      "@type": "Question",\n      "name": "How do I get access to ${product}?",\n      "acceptedAnswer": {\n        "@type": "Answer",\n        "text": "Access is provided immediately upon completing your setup or purchase."\n      }\n    }\n  ]\n};
                    outputArea.textContent = `<script type="application/ld+json">\n${JSON.stringify(schema, null, 2)}\n<\/script>`;
                } else if (format === "HTML Accordion Snippet") {
                    let htmlSnippet = `<div class="faq-container space-y-4">\n`;
                    htmlSnippet += `  <details class="p-4 border rounded-xl">\n    <summary class="font-bold cursor-pointer">What is ${product}?</summary>\n    <p class="mt-2 text-sm">${product} offers ${keyDetails}.</p>\n  </details>\n`;
                    htmlSnippet += `  <details class="p-4 border rounded-xl">\n    <summary class="font-bold cursor-pointer">Is commercial use allowed?</summary>\n    <p class="mt-2 text-sm">Yes, full rights are included for commercial deployment.</p>\n  </details>\n`;
                    htmlSnippet += `</div>`;
                    outputArea.textContent = htmlSnippet;
                } else {
                    let result = `❓ FREQUENTLY ASKED QUESTIONS (FAQ): ${product.toUpperCase()}\n`;
                    result += `TONE: ${tone}\n`;
                    result += `--------------------------------------------------\n\n`;

                    result += `Q1: What is ${product} and how does it work?\n`;
                    result += `A: ${product} is a streamlined solution designed to provide ${keyDetails}. It functions right out of the box with zero complex requirements.\n\n`;

                    result += `Q2: Is ${product} suitable for beginners?\n`;
                    result += `A: Absolutely. It is designed with an intuitive interface, making it simple for both beginners and experienced users to operate efficiently.\n\n`;

                    result += `Q3: What rights or access do I receive?\n`;
                    result += `A: You gain full functional access along with complete commercial re-use rights as specified in your license agreement.\n\n`;

                    result += `Q4: How can I contact customer support if I need assistance?\n`;
                    result += `A: Dedicated support is available via our official help desk and email channels for prompt response times.`;

                    outputArea.textContent = result;
                }

                statusText.textContent = "Completed";
            }, 600);
        }

        function copyToClipboard() {
            const text = document.getElementById('outputArea').textContent;
            navigator.clipboard.writeText(text).then(() => {
                const btn = document.getElementById('copyBtn');
                btn.textContent = "✅ Copied!";
                setTimeout(() => btn.textContent = "📋 Copy Output", 2000);
            });
        }
    </script>
</body>
</html>
